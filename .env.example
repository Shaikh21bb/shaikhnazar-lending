# Supabase (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Legacy fallback used by older deployments:
# SUPABASE_KEY=your_service_role_key

# LLM: choose OpenAI or Gemini. Keys are read only by /api server routes.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

BUSINESS_TIMEZONE=Asia/Almaty
PUBLIC_SITE_URL=https://shaikh.digital
AUTH_SECRET=replace-with-at-least-32-random-characters
# Dedicated 32+ character master secret for client API keys and Telegram tokens.
# Keep stable when rotating AUTH_SECRET, otherwise saved connections must be added again.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-long-random-string
CRON_SECRET=replace-with-a-long-random-string

# Local simulator. Keep false in production.
SALES_AGENT_DEV_MODE=true

# Optional self-hosted WhatsApp Web QR bridge (server/worker only).
# QR mode and Cloud API mode are mutually exclusive.
# WHATSAPP_DELIVERY_MODE=qr
# WHATSAPP_BRIDGE_SECRET=replace-with-at-least-32-random-characters
# Keep unset/false during QR pairing. Set true only after privacy and training checks.
# WHATSAPP_MESSAGE_DELIVERY_ENABLED=false
# Local Mac n8n + Ollama mode: enables server-provided training only.
# Keep WHATSAPP_MESSAGE_DELIVERY_ENABLED=false in this mode.
# WHATSAPP_LOCAL_AGENT_ENABLED=false
# Worker-only: BRIDGE_BASE_URL=https://YOUR_DOMAIN
# Worker-only: BRIDGE_AGENT_ID=uuid-of-the-selected-whatsapp-sales-agent
# Worker-only: WHATSAPP_SESSION_DIR=.wa-session

# Meta WhatsApp Cloud API (needed only for real WhatsApp traffic)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=ru
# UUID of the WhatsApp Sales Agent row in Supabase. Optional when there is only one.
WHATSAPP_AGENT_ID=
